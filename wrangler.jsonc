{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spesa-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "FAMILY", "class_name": "FamilyList" }]
  },
  // Workers AI legge le foto dei cartellini (modello di visione, cambiabile qui sotto)
  "ai": { "binding": "AI" },
  "vars": { "VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FamilyList"] }],
  "observability": { "enabled": true }
}
